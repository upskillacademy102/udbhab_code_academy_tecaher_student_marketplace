# ==========================================================
# TEMPLATE. Copy to .env and fill in the blanks:
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows)
# .env is git-ignored and must never be committed. Generate a fresh
# SECRET_KEY and use a real DB password for your own machine.
# ==========================================================

# ==========================================================
# DJANGO CORE SETTINGS
# ==========================================================
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================================
# DATABASE SETTINGS (PostgreSQL + PostGIS)
# ==========================================================
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=teacher_marketplace_db
DB_USER=teacher_marketplace_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ==========================================================
# JWT SETTINGS
# ==========================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_AUTH_COOKIE=access
JWT_REFRESH_COOKIE=refresh
JWT_AUTH_COOKIE_SECURE=False
JWT_AUTH_COOKIE_SAMESITE=Lax

# ==========================================================
# CSRF / CORS
# ==========================================================
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# ==========================================================
# EMAIL
# ==========================================================
# Console backend just prints emails to the terminal - fine for most
# local dev, but OTP codes won't reach a real inbox. To actually send
# mail (e.g. Gmail with a 16-character App Password from Google Account
# > Security > 2-Step Verification > App Passwords - a normal account
# password will NOT work), switch to:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=<16-char app password, no spaces>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER= upskillacademy102@gmail.com
EMAIL_HOST_PASSWORD=osnj cgzg msgk svew
DEFAULT_FROM_EMAIL=noreply@teachermarketplace.com
# Shown to suspended users as the appeal channel (defaults to DEFAULT_FROM_EMAIL).
SUPPORT_EMAIL=
# Optional ops inbox notified when a suspension appeal is filed.
TRUST_APPEALS_NOTIFY_EMAIL=

# ==========================================================
# SMS (OTP delivery - apps.trust)
# ==========================================================
# console just logs the code to the server log - fine for automated
# tests, but no real text is sent. Set to msg91 (with real credentials
# below) to actually deliver OTP SMS to Indian numbers.
TRUST_SMS_PROVIDER=console
# From the MSG91 dashboard (https://control.msg91.com) - Account > API
# Keys for MSG91_AUTH_KEY, and the ID of a DLT-approved OTP template
# (OTP > create/manage templates) for MSG91_TEMPLATE_ID.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ==========================================================
# STATIC & MEDIA
# ==========================================================
STATIC_URL=/static/
MEDIA_URL=/media/

# ==========================================================
# FRONTEND
# ==========================================================
FRONTEND_BASE_URL=http://localhost:3000

# ==========================================================
# LEAD UNLOCK ENTITLEMENTS
# ==========================================================
# False (the default) = subscription-allowance model: every lead costs one
# unlock, the allowance comes from the plan (Free 4 / Professional 10 /
# Elite 40), and paid teachers can buy never-expiring top-up packs.
# True restores the original variable-cost token economy - the wallet,
# token packages and per-category pricing all still exist, just dormant.
# See LEAD_UNLOCK_ENTITLEMENTS.md before flipping this.
TOKEN_SYSTEM_ENABLED=False
# Length of one allowance / billing cycle, in days. Billing and allowance
# share this one clock, so changing it changes both.
LEAD_UNLOCK_CYCLE_DAYS=30

# ==========================================================
# FAKE-LEAD REPORTS -> SUPER ADMIN ALERTS + AUTO-BAN
# ==========================================================
# Always on (no enable flag). Every "fake" rating a teacher files opens or
# updates that student's fake-lead alert on the Super Admin dashboard. A
# student is permanently banned once MORE THAN this many DISTINCT teachers
# report fake leads in the rolling window - never below the floor, so a
# couple of teachers can't get anyone banned.
FAKE_LEAD_AUTOBAN_WEEKLY=10
FAKE_LEAD_AUTOBAN_MONTHLY=15
FAKE_LEAD_AUTOBAN_MIN_DISTINCT_TEACHERS=3
FAKE_LEAD_REPORT_WEEKLY_WINDOW_DAYS=7
FAKE_LEAD_REPORT_MONTHLY_WINDOW_DAYS=30

# ==========================================================
# RAZORPAY (test keys from dashboard.razorpay.com)
# ==========================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================================
# CELERY / REDIS
# ==========================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==========================================================
# GEOCODING
# ==========================================================
GEOCODING_PROVIDER=nominatim
GOOGLE_GEOCODING_API_KEY=
