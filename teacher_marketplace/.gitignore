# ==========================================================
# Environment Variables
# ==========================================================
.env
.env.local
.env.*.local
.env.production
.env.staging
# .env.example IS committed - it is the redacted template.
!.env.example

# ==========================================================
# Python
# ==========================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Anchored to the repo root with a leading slash. Unanchored, `lib/` matches
# ANY directory called lib at any depth — it was silently excluding
# frontend/src/lib/ (the SPA's api client, types and intent helpers), which
# would have produced a checkout that could not build. These patterns only
# ever meant top-level setuptools output.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================================
# Virtual Environments
# ==========================================================
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ==========================================================
# Django
# ==========================================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
# collectstatic OUTPUT only. The source assets in /static/ (js, css,
# fonts) are hand-written and MUST be committed - do not ignore them.
staticfiles/
/staticfiles/

# ==========================================================
# Django Migrations (optional - team decision)
# ==========================================================
# Uncomment if your team regenerates migrations instead of tracking them
# */migrations/*.py
# !*/migrations/__init__.py

