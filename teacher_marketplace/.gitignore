# ==========================================================
# Frontend build tooling
# ==========================================================
# The 38 MB Tailwind standalone binary is downloaded, not committed.
# Grab it from https://github.com/tailwindlabs/tailwindcss/releases
# (tailwindcss-windows-x64.exe) into tools/. The BUILT stylesheet
# (static/css/app.css) IS committed so the app runs without the binary.
tools/tailwindcss.exe
tools/tailwindcss
schema.yml

